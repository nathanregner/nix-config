+// [#19907](https://github.com/rust-lang/rust-analyzer/issues/19907)
+#[test]
+#[cfg(not(windows))]
+fn test_watch_dir_recreation() {
+    if skip_slow_tests() {
+        return;
+    }
+
+    let tmp_dir = TestDir::new();
+    let root = tmp_dir.path().to_owned();
+
+    let server = Project::with_fixture(
+        r#"
+//- /Cargo.toml
+[package]
+name = "foo"
+version = "0.0.0"
+
+//- /src/lib.rs
+mod generated;
+
+//- /src/generated/mod.rs
+pub struct GeneratedV1;
+"#,
+    )
+    .tmp_dir(tmp_dir)
+    .with_config(json!({
+        "files": {
+            "watcher": "server"
+        }
+    }))
+    .server()
+    .wait_until_workspace_is_loaded();
+
+    let wait_for_symbol = |server: &support::Server, name: &str, timeout: Duration| {
+        let start = Instant::now();
+        loop {
+            let symbols =
+                server.send_request::<WorkspaceSymbolRequest>(WorkspaceSymbolParams::default());
+            let symbols: WorkspaceSymbolResponse = serde_json::from_value(symbols).unwrap();
+            let found = match &symbols {
+                WorkspaceSymbolResponse::Flat(s) => s.iter().any(|s| s.name == name),
+                WorkspaceSymbolResponse::Nested(s) => s.iter().any(|s| s.name == name),
+            };
+            if found {
+                return;
+            }
+            if start.elapsed() >= timeout {
+                panic!("timeout waiting for symbol `{name}` to appear, last result: {symbols:?}");
+            }
+            std::thread::sleep(Duration::from_millis(100));
+        }
+    };
+
+    // Verify initial state
+    wait_for_symbol(&server, "GeneratedV1", Duration::ZERO);
+
+    // Simulate code generation recreating a directory
+    fs::remove_dir_all(root.join("src/generated")).unwrap();
+    fs::create_dir_all(root.join("src/generated")).unwrap();
+    fs::write(root.join("src/generated/mod.rs"), "pub struct GeneratedV2;").unwrap();
+
+    // Verify watch was triggered
+    wait_for_symbol(&server, "GeneratedV2", Duration::from_secs(10));
+}
+
