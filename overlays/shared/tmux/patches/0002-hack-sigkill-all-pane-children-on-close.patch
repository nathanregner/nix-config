+
+/*
+ * Create a systemd scope for a given PID (called from parent process).
+ * Returns allocated scope name on success, NULL on failure.
+ */
+char *systemd_create_scope(pid_t pid, char **cause) {
+  sd_bus_error error = SD_BUS_ERROR_NULL;
+  sd_bus_message *m = NULL, *reply = NULL;
+  sd_bus *bus = NULL;
+  sd_bus_slot *slot = NULL;
+  char *name = NULL, *desc, *slice;
+  sd_id128_t uuid;
+  int r;
+  uint64_t elapsed_usec;
+  pid_t parent_pid;
+  struct timeval start, now;
+  struct systemd_job_watch watch = {};
+
+  gettimeofday(&start, NULL);
+
+  r = sd_bus_default_user(&bus);
+  if (r < 0) {
+    xasprintf(cause, "failed to connect to session bus: %s", strerror(-r));
+    goto finish;
+  }
+
+  r = sd_bus_match_signal(bus, &slot, "org.freedesktop.systemd1",
+                          "/org/freedesktop/systemd1",
+                          "org.freedesktop.systemd1.Manager", "JobRemoved",
+                          job_removed_handler, &watch);
+  if (r < 0) {
+    xasprintf(cause, "failed to create match signal: %s", strerror(-r));
+    goto finish;
+  }
+
+  r = sd_bus_message_new_method_call(
+      bus, &m, "org.freedesktop.systemd1", "/org/freedesktop/systemd1",
+      "org.freedesktop.systemd1.Manager", "StartTransientUnit");
+  if (r < 0) {
+    xasprintf(cause, "failed to create bus message: %s", strerror(-r));
+    goto finish;
+  }
+
+  r = sd_id128_randomize(&uuid);
+  if (r < 0) {
+    xasprintf(cause, "failed to generate uuid: %s", strerror(-r));
+    goto finish;
+  }
+  xasprintf(&name, "tmux-pane-" SD_ID128_UUID_FORMAT_STR ".scope",
+            SD_ID128_FORMAT_VAL(uuid));
+  r = sd_bus_message_append(m, "s", name);
+  if (r < 0) {
+    xasprintf(cause, "failed to append to bus message: %s", strerror(-r));
+    free(name);
+    name = NULL;
+    goto finish;
+  }
+
+  r = sd_bus_message_append(m, "s", "fail");
+  if (r < 0) {
+    xasprintf(cause, "failed to append to bus message: %s", strerror(-r));
+    free(name);
+    name = NULL;
+    goto finish;
+  }
+
+  r = sd_bus_message_open_container(m, 'a', "(sv)");
+  if (r < 0) {
+    xasprintf(cause, "failed to start properties array: %s", strerror(-r));
+    free(name);
+    name = NULL;
+    goto finish;
+  }
+
+  parent_pid = getpid();
+  xasprintf(&desc, "tmux pane pid %ld", (long)pid);
+  r = sd_bus_message_append(m, "(sv)", "Description", "s", desc);
+  free(desc);
+  if (r < 0) {
+    xasprintf(cause, "failed to append to properties: %s", strerror(-r));
+    free(name);
+    name = NULL;
+    goto finish;
+  }
+
+  /* Use SIGKILL to kill all processes including those ignoring signals */
+  r = sd_bus_message_append(m, "(sv)", "KillSignal", "i", SIGKILL);
+  if (r < 0) {
+    xasprintf(cause, "failed to append to properties: %s", strerror(-r));
+    free(name);
+    name = NULL;
+    goto finish;
+  }
+
+  r = sd_pid_get_user_slice(parent_pid, &slice);
+  if (r < 0) {
+    slice = xstrdup("app-tmux.slice");
+  }
+  r = sd_bus_message_append(m, "(sv)", "Slice", "s", slice);
+  free(slice);
+  if (r < 0) {
+    xasprintf(cause, "failed to append to properties: %s", strerror(-r));
+    free(name);
+    name = NULL;
+    goto finish;
+  }
+
+  r = sd_bus_message_append(m, "(sv)", "PIDs", "au", 1, (uint32_t)pid);
+  if (r < 0) {
+    xasprintf(cause, "failed to append to properties: %s", strerror(-r));
+    free(name);
+    name = NULL;
+    goto finish;
+  }
+
+  r = sd_bus_message_append(m, "(sv)", "CollectMode", "s", "inactive-or-failed");
+  if (r < 0) {
+    xasprintf(cause, "failed to append to properties: %s", strerror(-r));
+    free(name);
+    name = NULL;
+    goto finish;
+  }
+
+  r = sd_bus_message_close_container(m);
+  if (r < 0) {
+    xasprintf(cause, "failed to end properties array: %s", strerror(-r));
+    free(name);
+    name = NULL;
+    goto finish;
+  }
+
+  r = sd_bus_message_append(m, "a(sa(sv))", 0);
+  if (r < 0) {
+    xasprintf(cause, "failed to append to bus message: %s", strerror(-r));
+    free(name);
+    name = NULL;
+    goto finish;
+  }
+
+  r = sd_bus_call(bus, m, 1000000, &error, &reply);
+  if (r < 0) {
+    if (error.message != NULL)
+      xasprintf(cause, "StartTransientUnit failed: %s", error.message);
+    else
+      xasprintf(cause, "StartTransientUnit failed: %s", strerror(-r));
+    free(name);
+    name = NULL;
+    goto finish;
+  }
+
+  r = sd_bus_message_read(reply, "o", &watch.path);
+  if (r < 0) {
+    xasprintf(cause, "failed to parse method reply: %s", strerror(-r));
+    free(name);
+    name = NULL;
+    goto finish;
+  }
+
+  while (!watch.done) {
+    r = sd_bus_process(bus, NULL);
+    if (r < 0) {
+      xasprintf(cause, "failed waiting for scope: %s", strerror(-r));
+      free(name);
+      name = NULL;
+      goto finish;
+    }
+    if (r > 0)
+      continue;
+
+    gettimeofday(&now, NULL);
+    elapsed_usec =
+        (now.tv_sec - start.tv_sec) * 1000000 + now.tv_usec - start.tv_usec;
+    if (elapsed_usec >= 1000000) {
+      xasprintf(cause, "timeout waiting for scope");
+      free(name);
+      name = NULL;
+      goto finish;
+    }
+
+    r = sd_bus_wait(bus, 1000000 - elapsed_usec);
+    if (r < 0) {
+      xasprintf(cause, "failed waiting for scope: %s", strerror(-r));
+      free(name);
+      name = NULL;
+      goto finish;
+    }
+  }
+
+  log_debug("systemd_create_scope: created %s for pid %d", name, (int)pid);
+
+finish:
+  sd_bus_error_free(&error);
+  sd_bus_message_unref(m);
+  sd_bus_message_unref(reply);
+  sd_bus_slot_unref(slot);
+  sd_bus_unref(bus);
+
+  return (name);
+}
+
+/*
+ * Stop a systemd scope, killing all processes in it.
+ */
+void systemd_stop_scope(const char *name) {
+  sd_bus_error error = SD_BUS_ERROR_NULL;
+  sd_bus *bus = NULL;
+  int r;
+
+  if (name == NULL)
+    return;
+
+  r = sd_bus_default_user(&bus);
+  if (r < 0) {
+    log_debug("systemd_stop_scope: failed to connect: %s", strerror(-r));
+    goto finish;
+  }
+
+  r = sd_bus_call_method(bus, "org.freedesktop.systemd1",
+                         "/org/freedesktop/systemd1",
+                         "org.freedesktop.systemd1.Manager", "StopUnit", &error,
+                         NULL, "ss", name, "fail");
+  if (r < 0) {
+    log_debug("systemd_stop_scope: StopUnit %s failed: %s", name,
+              error.message ? error.message : strerror(-r));
+  } else {
+    log_debug("systemd_stop_scope: stopped %s", name);
+  }
+
+finish:
+  sd_bus_error_free(&error);
+  sd_bus_unref(bus);
+}
