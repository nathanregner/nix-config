 }
+
+void osdep_kill_tree(pid_t pid) {
+  pid_t *children;
+  int nchildren, capacity, bufsize, i;
+
+  log_debug("osdep_kill_tree: killing tree from pid %d", (int)pid);
+
+  if (pid <= 1)
+    return;
+
+  /*
+   * proc_listchildpids returns the number of pids, not bytes. Calling it
+   * with a NULL buffer returns an upper bound suitable for sizing the
+   * allocation, with extra space in case children spawn between calls.
+   */
+  nchildren = proc_listchildpids(pid, NULL, 0);
+  if (nchildren > 0) {
+    /* Add some buffer for race conditions */
+    capacity = nchildren + 16;
+    bufsize = capacity * sizeof(pid_t);
+    children = malloc(bufsize);
+    if (children != NULL) {
+      nchildren = proc_listchildpids(pid, children, bufsize);
+      if (nchildren > capacity)
+        nchildren = capacity;
+      for (i = 0; i < nchildren; i++) {
+        if (children[i] > 1) {
+          log_debug("osdep_kill_tree: found child %d of %d", (int)children[i],
+                    (int)pid);
+          osdep_kill_tree(children[i]);
+        }
+      }
+      free(children);
+    }
+  }
+
+  /* Kill the process itself with SIGKILL */
+  kill(pid, SIGKILL);
+}
